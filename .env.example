# Copy to .env and fill in real values — never commit .env

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/hallal_invest

# ── Application ───────────────────────────────────────────────────────────────
DEBUG=false
SECRET_KEY=change-me-in-production

# ── External API keys ─────────────────────────────────────────────────────────
FMP_API_KEY=
ALPHA_VANTAGE_KEY=
MUSAFFA_API_KEY=

# ── Shariah thresholds (§5.1) — override defaults only if needed ─────────────
# SHARIAH_MAX_DEBT_RATIO=0.33
# SHARIAH_MAX_HARAM_REVENUE=0.05
# SHARIAH_MAX_RECEIVABLES_RATIO=0.49
# SHARIAH_MIN_PURIFICATION_RATIO=0.01


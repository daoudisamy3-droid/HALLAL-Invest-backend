ncy"}, "opened_at": {"type": "string", "format": "date-time", "title": "Opened At"}, "quantity": {"type": "string", "title": "Quantity"}, "avg_cost": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Avg Cost", "description": "Weighted-average cost of currently-held shares (fees included). None when quantity == 0."}, "cost_basis": {"type": "string", "title": "Cost Basis", "description": "Total cost of currently-held shares = quantity \u00d7 avg_cost."}, "last_price": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Last Price", "description": "Most recent price for the position. SEMANTIC CHANGE in step 5: if a YFinance quote is available it is used here (live market price); otherwise it falls back to the most recent transaction price on this position. See ``price_source`` to disambiguate."}, "price_source": {"type": "string", "enum": ["live", "transaction", "unavailable"], "title": "Price Source", "description": "Where ``last_price`` comes from. \"live\": YFinance regularMarketPrice. \"transaction\": fallback to last tx price (YFinance unavailable, or no YFinance client wired). \"unavailable\": no usable price at all (position has zero transactions or YFinance + fallback both failed).", "default": "transaction"}, "current_value": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Current Value", "description": "quantity \u00d7 last_price (None if no transactions or qty==0)."}, "unrealized_pnl": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Unrealized Pnl", "description": "current_value \u2212 cost_basis (None if current_value is None)."}, "realized_pnl": {"type": "string", "title": "Realized Pnl", "description": "Cumulated profit/loss from SELL transactions on this position."}, "transactions_count": {"type": "integer", "title": "Transactions Count"}}, "type": "object", "required": ["id", "symbol", "currency", "opened_at", "quantity", "cost_basis", "realized_pnl", "transactions_count"], "title": "PositionRead", "description": "A position with all derived fields computed on the fly.\n\nAll Decimal fields are USD (single-currency in V1). When the position\nis closed (``quantity == 0``), the average-cost-dependent fields\n(``avg_cost``, ``current_value``, ``unrealized_pnl``) become ``None``\nwhile ``realized_pnl`` keeps the accumulated P&L over the lifetime\nof the position."}, "QualityComponent": {"properties": {"score": {"anyOf": [{"type": "number"}, {"type": "null"}], "title": "Score", "description": "Normalised 0-100 score, or null when the component is N/A."}, "available": {"type": "boolean", "title": "Available", "description": "True iff the component contributed to the weighted quality."}, "details": {"additionalProperties": true, "type": "object", "title": "Details"}}, "additionalProperties": true, "type": "object", "required": ["available"], "title": "QualityComponent", "description": "A single quality-score component (0-100) with traceability details."}, "ShariahCheck": {"properties": {"value": {"type": "number", "title": "Value"}, "threshold": {"type": "number", "title": "Threshold"}, "pass": {"type": "boolean", "title": "Pass", "description": "True if value <= threshold (alias `pass` matches \u00a75.2)"}}, "type": "object", "required": ["value", "threshold", "pass"], "title": "ShariahCheck", "description": "One of the 4 bloquant checks evaluated against \u00a75.1 thresholds.\n\nPopulated only when the upstream surfaces raw ratios. Empty in\nfree-tier mode \u2014 see schema docstring."}, "ShariahRatios": {"properties": {"debt_to_marketcap": {"anyOf": [{"type": "number"}, {"type": "null"}], "title": "Debt To Marketcap"}, "debt_to_assets": {"anyOf": [{"type": "number"}, {"type": "null"}], "title": "Debt To Assets"}, "cash_to_marketcap": {"anyOf": [{"type": "number"}, {"type": "null"}], "title": "Cash To Marketcap"}, "impure_revenue_ratio": {"anyOf": [{"type": "number"}, {"type": "null"}], "title": "Impure Revenue Ratio"}, "interest_income_ratio": {"anyOf": [{"type": "number"}, {
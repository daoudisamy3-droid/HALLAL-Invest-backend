ssful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SynthesisReport"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}}, "components": {"schemas": {"FinancialsSnapshot": {"properties": {"ticker": {"type": "string", "title": "Ticker", "description": "Ticker normalised to uppercase"}, "cik": {"anyOf": [{"type": "integer"}, {"type": "null"}], "title": "Cik", "description": "SEC Central Index Key, None if NOT_COVERED"}, "entity_name": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Entity Name"}, "verdict": {"type": "string", "enum": ["AVAILABLE", "NOT_COVERED", "ERROR"], "title": "Verdict"}, "fiscal_year": {"anyOf": [{"type": "integer"}, {"type": "null"}], "title": "Fiscal Year"}, "period_end": {"anyOf": [{"type": "string", "format": "date"}, {"type": "null"}], "title": "Period End"}, "form": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Form", "description": "e.g. \"10-K\""}, "accession_number": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Accession Number"}, "filed": {"anyOf": [{"type": "string", "format": "date"}, {"type": "null"}], "title": "Filed"}, "revenues": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Revenues"}, "net_income": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Net Income"}, "total_assets": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Total Assets"}, "long_term_debt": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Long Term Debt"}, "short_term_borrowings": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Short Term Borrowings"}, "cash_and_equivalents": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Cash And Equivalents"}, "interest_income_operating": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Interest Income Operating"}, "eps_diluted": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Eps Diluted"}, "operating_cash_flow": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Operating Cash Flow"}, "capex": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Capex"}, "stockholders_equity": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Stockholders Equity"}, "source": {"type": "string", "enum": ["SEC EDGAR API", "cache (financials_cache)"], "title": "Source"}, "cached": {"type": "boolean", "title": "Cached", "default": false}, "cache_age_hours": {"anyOf": [{"type": "number"}, {"type": "null"}], "title": "Cache Age Hours"}, "reason": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Reason"}}, "type": "object", "required": ["ticker", "verdict", "source"], "title": "FinancialsSnapshot", "description": "Latest annual snapshot extracted from SEC EDGAR for a US-listed ticker.\n\nVerdict semantics:\n  - AVAILABLE   : metadata + 11 concept values populated (some may be\n                  None if the concept is not reported by the company)\n  - NOT_COVERED : ticker not in SEC EDGAR universe (non-US, unknown,\n                  or de-listed)\n  - ERROR       : transient upstream failure (timeout / 5xx / network)"}, "GateResult": {"properties": {"verdict": {"type": "string", "enum": ["PASS", "WARNING", "FAIL", "INSUFFICIENT_DATA"], "title": "Verdict"}, "details": {"additionalProperties": true, "type": "object", "title": "Details"}, "reason": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Reason"}}, "additionalProperties": true, "type": "object", "required": ["verdict"], "title": "GateResult", "description": "Generic per-gate result with verdict + open-shape details."}, "HTTPValidationError": {"properties": {"detail": {"items": {"$ref": "#/components/schemas/ValidationError"}, "type": "array", "title": "Detail"}}, "type": "object", "title": "HTTPValidationError"}, "InvestissableReport": {"properties": {"symbol": {"type": "string", "title": "Symbol"}, "verdict": {"type": "string", "enum": ["OUI", "NON", "INCERTAIN"], "title": "Verdict"}, "label": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Label", "description": "Verbose label e.g. \"OUI - QUALIT\u00c9 EXCELLENTE\" (\u00a74.2.3)."}, "quality_score": {"anyOf": [{"type": "number"}, {"type": "null"}], "title": "Quality Score"}, "blocked_at": {"anyOf": [{"type": "string", "enum": ["aaoifi", "altman", "fraud"]}, {"type": "null"}], "title": "Blocked At"}, "gates": {"additionalProperties": {"$ref": "#/components/schemas/GateResult"}, "propertyNames": {"enum": ["aaoifi", "altman", "fraud"]}, "type": "object", "title": "Gates"}, "quality_components": {"additionalProperties": {"$ref": "#/components/schemas/QualityComponent"}, "propertyNames": {"enum": ["piotroski", "growth", "smart_money", "capital_allocation", "earnings_stability"]}, "type": "object", "title": "Quality Components"}, "data_completeness": {"type": "string", "enum": ["FULL", "PARTIAL", "INSUFFICIENT"], "title": "Data Completeness"}, "warnings": {"items": {"type": "string"}, "type": "array", "title": "Warnings"}, "reason": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Reason"}}, "type": "object", "required": ["symbol", "verdict", "data_completeness"], "title": "InvestissableReport", "description": "Top-level response of GET /api/v1/investissable/{symbol}.\n\nThe verdict is one of three French strings (\u00a74.2.3 / Q10 plan):\n\n  - ``OUI``        : all gates passed + quality score \u2265 45.\n  - ``NON``        : a gate failed OR quality score < 45.\n  - ``INCERTAIN``  : Altman INSUFFICIENT_DATA, quality data\n                     insufficient, or non-US ticker (V1 limitation).\n\n``blocked_at`` is set when a gate failure short-circuits the\npipeline. ``data_completeness`` reflects how many components\ncontributed (FULL = 5/5, PARTIAL = 1-4/5, INSUFFICIENT = 0/5 or\nnon-US)."}, "MethodResult": {"properties": {"available": {"type": "boolean", "title": "Available"}, "fair_value": {"anyOf": [{"type": "string"}, {"type": 